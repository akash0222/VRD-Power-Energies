NODE_ENV=production
PORT=5000
# MongoDB Atlas connection string. Keep private.
MONGODB_URI=mongodb+srv://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_CLUSTER.mongodb.net/vrd_power_energies?retryWrites=true&w=majority
# Generate a unique random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Admin credentials: create a bcrypt hash for your chosen password; never store plain password here.
ADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
# Exact production Vercel origin(s), comma-separated. Example: https://your-project.vercel.app
FRONTEND_ORIGINS=https://REPLACE_WITH_YOUR_VERCEL_SUBDOMAIN
# Email notification settings from your chosen SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
NOTIFY_EMAIL=REPLACE_WITH_BUSINESS_EMAIL
